# API Base URL Configuration
# This is the base URL for your backend API (without trailing slash)
# 
# For local development:
VITE_API_BASE_URL=http://localhost:8080/api
# 
# For production, replace with your actual domain:
# VITE_API_BASE_URL=https://api.your-domain.com/api
# 
# Examples:
# - Same domain with /api path: https://example.com/api
# - Subdomain: https://api.example.com/api
# - Different domain: https://api.billing-tool.com/api
