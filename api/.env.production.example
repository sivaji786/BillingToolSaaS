#--------------------------------------------------------------------
# Example Production Environment Configuration
# Copy this to .env and customize for your production deployment
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Environment: production (enables optimizations, disables debug)
CI_ENVIRONMENT = production

# Frontend URL for CORS configuration (comma-separated for multiple origins)
# Example: https://app.your-domain.com,https://www.your-domain.com
FRONTEND_URL = https://your-domain.com

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Backend base URL (your API domain)
app.baseURL = https://api.your-domain.com/

# Force HTTPS
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = your-db-hostname
database.default.database = billing_tool
database.default.username = your-db-username
database.default.password = your-secure-db-password
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Generate a secure key: php spark key:generate
encryption.key = your-secure-encryption-key-here

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# Production logging (errors only)
logger.threshold = 1

#--------------------------------------------------------------------
# JWT
#--------------------------------------------------------------------

# Generate a secure random string for production
JWT_SECRET = your-very-secure-jwt-secret-key-change-in-production

#--------------------------------------------------------------------
# SSO — Single Sign-On (OAuth 2.0)
#--------------------------------------------------------------------

# Redirect base URL — must match what you register in each IdP console
SSO_REDIRECT_BASE_URL = https://api.billingtool.com

# Encryption key for storing SSO tokens at rest (AES-256-GCM)
# Generate with: openssl rand -hex 32
SSO_ENCRYPTION_KEY = your-32-byte-hex-encryption-key

# Feature flags — set to true to enable each provider
SSO_GOOGLE_ENABLED    = false
SSO_MICROSOFT_ENABLED = false
SSO_GITHUB_ENABLED    = false

# Google OAuth 2.0 — https://console.cloud.google.com
GOOGLE_CLIENT_ID     = your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = GOCSPX-xxxx

# Microsoft OAuth 2.0 — https://portal.azure.com
MICROSOFT_CLIENT_ID     = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET = xxxx~xxxx
MICROSOFT_TENANT_ID     = common

# GitHub OAuth 2.0 — GitHub -> Settings -> Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID     = Iv1.xxxxxxxxxx
GITHUB_CLIENT_SECRET = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SAML 2.0 SP key/cert (generate with: openssl req -x509 -newkey rsa:2048 -keyout sp.key -out sp.crt -days 3650 -nodes)
# Paste the raw base64 cert body (without -----BEGIN/END----- headers)
SAML_SP_CERT = 
SAML_SP_KEY  = 

# Generic OIDC — configured per-tenant in Settings > SSO & SAML tab
# No global env vars needed; stored encrypted in tenant_sso_configs table

#--------------------------------------------------------------------
# WorkHub — External Module Webhooks (Sprint D)
#--------------------------------------------------------------------

# HMAC-SHA256 shared secret for inbound webhooks from PC-13, PFE, M-02, PPT.
# The originating module must sign each request body with this secret and send
# the signature in the X-WorkHub-Signature header as: sha256=<hex>
# Generate with: openssl rand -hex 32
WORKHUB_WEBHOOK_SECRET = your-secure-webhook-secret-change-in-production

#--------------------------------------------------------------------
# Redis — L2 Translation Cache + optional CI4 cache handler (Sprint E)
#--------------------------------------------------------------------

# When REDIS_HOST is set, Cache.php automatically switches to the 'redis' handler,
# enabling 30-day L2 translation cache and faster rate-limit counters.
# Leave empty to fall back to file-based caching.
REDIS_HOST     =
REDIS_PORT     = 6379
REDIS_PASSWORD =
REDIS_DATABASE = 0
REDIS_TIMEOUT  = 0

#--------------------------------------------------------------------
# Pusher / Soketi — Production WebSocket (Sprint E)
#--------------------------------------------------------------------

# Option A: Managed Pusher (pusher.com)
PUSHER_APP_ID     =
PUSHER_APP_KEY    =
PUSHER_APP_SECRET =
PUSHER_APP_CLUSTER = eu
PUSHER_HOST       = api.pusherapp.com
PUSHER_PORT       = 443
PUSHER_SCHEME     = https

# Option B: Self-hosted Soketi (soketi.app) — overrides Pusher if SOKETI_HOST is set
# SOKETI_HOST       = soketi.example.com
# SOKETI_PORT       = 6001
# SOKETI_APP_ID     = app-id
# SOKETI_APP_KEY    = app-key
# SOKETI_APP_SECRET = app-secret
