#--------------------------------------------------------------------
# Production Environment Configuration
# Upload this file as .env to your production server
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Environment: production (enables optimizations, disables debug)
CI_ENVIRONMENT = production

# Frontend URL for CORS configuration (comma-separated for multiple origins)
FRONTEND_URL = https://www.humple.org

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Backend base URL (your API domain)
app.baseURL = https://www.humple.org/api/

# Force HTTPS
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# Production database credentials
database.default.hostname = localhost
database.default.database = c30040_humpl
database.default.username = c30040_humpl
database.default.password = NotAk@1$dr6#
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# Production logging (errors only)
logger.threshold = 1

